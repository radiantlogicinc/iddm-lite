# Image tags
ZOOKEEPER_VERSION="3.5.8-secure"
IDDM_VERSION="8.2.2"

# Credentials
IDDM_ROOT_USERNAME="cn=directory manager"
ZOOKEEPER_USERNAME=admin

# FID Memory - Container must be greater than sum of parts
FID_CONTAINER_MAX_MEMORY_MB=3300
FID_SERVER_MAX_MEMORY_MB=2600
FID_SCHEDULER_MAX_MEMORY_MB=250
FID_SYNC_AGENT_MAX_MEMORY_MB=250

# Other Memory
ZOOKEEPER_MAX_MEMORY_MB=500
SETUP_MAX_MEMORY_MB=128