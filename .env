# Image tags
ZOOKEEPER_BASE_VERSION="3.5.8"
IDDM_VERSION="8.5.2"
# Derived from above variables, do not touch this one
ZOOKEEPER_VERSION="${ZOOKEEPER_BASE_VERSION}-iddm-${IDDM_VERSION}"

# Credentials
IDDM_ROOT_USERNAME="cn=directory manager"
ZOOKEEPER_USERNAME=admin

# FID Memory - Container must be greater than sum of parts
FID_CONTAINER_MAX_MEMORY_MB=3328
FID_SERVER_MAX_MEMORY_MB=2688
FID_SCHEDULER_MAX_MEMORY_MB=256
FID_SYNC_AGENT_MAX_MEMORY_MB=256

# Other Memory
ZOOKEEPER_MAX_MEMORY_MB=512
SETUP_MAX_MEMORY_MB=128